{
    "configurations": [
        {
            "name": "Pico",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/dhcpserver",
                "${workspaceFolder}/src/dnsserver",
                "${workspaceFolder}/generated",
                "${userHome}/.pico-sdk/sdk/2.3.0/**"
            ],
            "forcedInclude": [
                "${workspaceFolder}/build/generated/pico_base/pico/config_autogen.h",
                "${userHome}/.pico-sdk/sdk/2.3.0/src/common/pico_base_headers/include/pico.h"
            ],
            "compilerPath": "${userHome}/.pico-sdk/toolchain/15_2_Rel1/bin/arm-none-eabi-gcc",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "cStandard": "c17",
            "cppStandard": "c++14",
            "intelliSenseMode": "linux-gcc-arm"
        },
        {
            "name": "Host Tests",
            "compilerPath": "/opt/homebrew/opt/llvm/bin/clang",
            "defines": [
                "TEST_MODE=1"
            ],
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/dhcpserver",
                "${workspaceFolder}/src/dnsserver",
                "${workspaceFolder}/generated",
                "${workspaceFolder}/tests"
            ],
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}
